[Unit]
Description=F1 model car
After=bluetooth.target
Wants=bluetooth.target

[Service]
Type=simple
WorkingDirectory=/home/pi/f1car
ExecStart=/usr/bin/python3 -u /home/pi/f1car/main.py
ExecStopPost=/usr/bin/python3 /home/pi/f1car/emergency_stop.py
Restart=on-failure
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
